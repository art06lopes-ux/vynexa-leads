# Copie para .env.local e preencha. Ver docs/SETUP.md.
# Nenhum valor real entra neste arquivo.

# --- Banco (Turso) ---------------------------------------------------
# Produção: libsql://<seu-banco>-<org>.turso.io
# Desenvolvimento sem conta no Turso: file:./local.db
TURSO_DATABASE_URL=

# Token do banco. Não é necessário quando a URL começa com file:.
TURSO_AUTH_TOKEN=

# --- Acesso ao painel -------------------------------------------------
# Senha única. A ferramenta tem um usuário só; não há cadastro.
SENHA_PAINEL=

# Assina o cookie de sessão. Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor derruba todas as sessões abertas.
SEGREDO_SESSAO=

# --- OpenStreetMap ----------------------------------------------------
# E-mail de contato enviado no User-Agent para a Overpass e o Nominatim.
# Os dois exigem identificação e um canal para avisar antes de bloquear;
# sem isso o bloqueio vem sem aviso.
# https://operations.osmfoundation.org/policies/nominatim/
OSM_CONTATO=

# --- IA (Etapa 2) ------------------------------------------------------
# Chave do Google AI Studio. Gratuita e sem cartao: https://aistudio.google.com/apikey
# Usada so pelo worker, que roda a analise dos leads.
GEMINI_API_KEY=

# --- Checkout (Stripe) -------------------------------------------------
# https://dashboard.stripe.com/apikeys  (comece com a chave de TESTE sk_test_)
STRIPE_SECRET_KEY=

# Aparece ao criar o endpoint em https://dashboard.stripe.com/webhooks
# Sem ele as vendas nao sao confirmadas sozinhas.
STRIPE_WEBHOOK_SECRET=

# --- Notificacoes push (PWA) -------------------------------------------
# Gere o par uma vez com: npm run push:chaves
# A publica vai ao navegador; a privada fica so no servidor. Trocar o par
# invalida todas as assinaturas: cada aparelho precisaria ativar de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Gmail (campanhas de e-mail) ---------------------------------------
# Credenciais OAuth de um projeto no Google Cloud (gratuito, sem cartao).
# Tela de consentimento em modo "Teste" basta para uma conta so.
# URI de redirecionamento autorizado: https://SEU-SITE/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
